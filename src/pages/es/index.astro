---
// src/pages/es/index.astro — Home page (Spanish locale)
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/lib/i18n';
import HeroIsland from '@/components/islands/HeroIsland';
import ServicesSection from '@/components/ServicesSection.astro';
import PortfolioIsland from '@/components/islands/PortfolioIsland';
import BottomGridWrapper from '@/components/BottomGridWrapper.astro';
import StructuredData from '@/components/StructuredData.astro';
import es from '../../../public/locales/es/common.json';

const lang = 'es' as const;
const t = useTranslations(lang);

const heroProps = {
  line1: t('hero.line1'),
  line2: t('hero.line2'),
  description: t('hero.description'),
  ctaPrimary: t('hero.ctaPrimary'),
};

const projects = es.portfolio.projects;
const portfolioStrings = {
  title: t('portfolio.title'),
  titleAccent: t('portfolio.titleAccent'),
  description: t('portfolio.description'),
  websiteLabel: t('portfolio.website'),
};

const contactStrings = {
  title: t('contact.title'),
  titleAccent: t('contact.titleAccent'),
  headline: t('contact.headline'),
  subhead: t('contact.subhead'),
  email: t('contact.email'),
  phone: t('contact.phone'),
  portraitAlt: 'Jesús Ordosgoitty — Desarrollador Web Full Stack',
};
---

<BaseLayout
  title="Jesús Ordosgoitty — Transforma Tu Presencia Digital"
  description={t('hero.description')}
  lang={lang}
  alternateUrl="https://jodaz.xyz/"
>
  <StructuredData schemas={[{ type: 'person', lang: 'es' }, { type: 'professionalService', lang: 'es' }]} />
  <HeroIsland {...heroProps} client:load />
  <ServicesSection lang={lang} />
  <PortfolioIsland
    projects={projects}
    strings={portfolioStrings}
    client:visible
  />
  <BottomGridWrapper 
    lang={lang} 
    showContact={true} 
    contactStrings={contactStrings} 
  />
</BaseLayout>

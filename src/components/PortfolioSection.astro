---
// src/components/PortfolioSection.astro
import { useTranslations } from '@/lib/i18n';
import LightRays from '@/components/LightRays';
import portfolioFruga from '@/assets/fruga.png';
import AnimatedContent from '@/component/AnimatedContent';

interface Project {
  id: string;
  title: string;
  description: string;
  category: string;
  technologies: string[];
  image: string;
  code?: string;
  website?: string;
}

interface Props {
  projects: Project[];
  lang?: any;
}

const { projects, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const imageMap: Record<string, any> = {
  'horsy.png': 'https://res.cloudinary.com/jodaz/image/upload/v1727464583/images/projects/horsy.png',
  'fruga.png': portfolioFruga,
};
---

<section id="portfolio" class="min-h-screen bg-slate-900 relative overflow-hidden flex items-center py-24 border-t-2 border-white/5">
  <div class="absolute inset-0 z-0">
    <LightRays client:visible raysColor="#4833e6" rayLength={600} pulsating />
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <AnimatedContent client:visible className="mb-20 text-left">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        {t('portfolio.title')}{' '}
        <span class="text-primary">{t('portfolio.titleAccent')}</span>
      </h2>
      <p class="text-xl text-gray-300 max-w-3xl leading-relaxed">
        {t('portfolio.description')}
      </p>
    </AnimatedContent>

    <div class="grid grid-cols-1 md:grid-cols-2 border-t-2 border-l-2 border-white/10">
      {projects.map((project, index) => {
        const image = imageMap[project.image] || project.image;
        const imageUrl = typeof image === 'string' ? image : image.src;
        
        return (
          <AnimatedContent 
            client:visible 
            delay={index * 0.15}
            className="group relative bg-slate-900/40 backdrop-blur-md border-r-2 border-b-2 border-white/10 p-12 transition-all duration-500 hover:bg-slate-800/60 overflow-hidden"
          >
            <div class="relative z-10 flex flex-col h-full">
              {/* Category */}
              <div class="mb-8">
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-primary/10 text-primary border border-primary/20">
                  {project.category}
                </span>
              </div>

              {/* Title & Description */}
              <h3 class="text-3xl font-bold text-white mb-6 group-hover:text-primary transition-colors duration-300">
                {project.title}
              </h3>
              <p class="text-gray-200 text-lg leading-relaxed mb-10 flex-1">
                {project.description}
              </p>

              {/* Technologies */}
              <div class="flex flex-wrap gap-2 mb-10">
                {project.technologies.map((tech) => (
                  <span class="bg-white/5 text-gray-400 px-3 py-1 rounded-md text-xs font-semibold border border-white/10 uppercase tracking-wider">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Image Preview - Subtle background effect */}
              <div class="absolute -right-20 -bottom-20 w-80 h-80 opacity-10 group-hover:opacity-20 group-hover:scale-110 transition-all duration-1000 pointer-events-none">
                 <img 
                  src={imageUrl} 
                  alt="" 
                  class="w-full h-full object-cover rounded-full grayscale blur-sm"
                />
              </div>

              {/* Actions */}
              <div class="flex items-center gap-6 mt-auto pt-8 border-t border-white/5">
                {project.website && (
                  <a 
                    href={project.website} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex items-center gap-2 text-white font-bold hover:text-primary transition-colors group/link"
                  >
                    <span>{t('portfolio.website')}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-1 group-hover/link:-translate-y-1 transition-transform duration-300"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  </a>
                )}
                {project.code && (
                  <a 
                    href={project.code} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="flex items-center gap-2 text-gray-500 hover:text-white transition-colors"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    <span>{t('buttons.code')}</span>
                  </a>
                )}
              </div>
            </div>
          </AnimatedContent>
        )
      })}
    </div>
  </div>
</section>

---
// src/components/ContactSection.astro
import founder from '@/assets/images/founder.png';

interface ContactStrings {
  title: string;
  titleAccent: string;
  headline: string;
  subhead: string;
  email: string;
  phone: string;
  portraitAlt: string;
}

interface Props {
  strings: ContactStrings;
}

const { strings } = Astro.props;
---

<section id="contact" class="py-20 bg-background">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16 animate-fade-in">
      <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
        {strings.title}{' '}
        <span class="text-primary">{strings.titleAccent}</span>
      </h2>
      <br class="hidden md:block" />
    </div>

    <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto items-end">
      <!-- Contact Information -->
      <div class="space-y-8 animate-slide-up lg:order-1 order-2">
        <div>
          <h3 class="text-3xl font-bold text-foreground mb-6">
            {strings.headline}
          </h3>
          <p class="text-muted-foreground leading-relaxed mb-8">
            {strings.subhead}
          </p>
        </div>

        <!-- Mobile portrait -->
        <div class="flex justify-center md:hidden">
          <div class="w-56 h-56 sm:w-64 sm:h-64 bg-muted relative rounded-2xl overflow-hidden shadow-lg animate-slide-up-delayed">
            <img
              src={founder.src}
              alt={strings.portraitAlt}
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div class="space-y-6">
          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-foreground">{strings.email}</h4>
              <p class="text-muted-foreground">jesus@jodaz.xyz</p>
            </div>
          </div>

          <div class="flex items-center space-x-4">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-foreground">{strings.phone}</h4>
              <p class="text-muted-foreground">+58 (412) 131-5110</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Portrait desktop -->
      <div class="hidden md:flex justify-center lg:order-2 order-3">
        <div class="w-56 h-56 sm:w-64 sm:h-64 lg:w-72 lg:h-72 xl:w-80 xl:h-80 bg-muted relative rounded-2xl overflow-hidden shadow-lg transform transition-transform will-change-transform animate-slide-up-delayed">
          <img
            src={founder.src}
            alt={strings.portraitAlt}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>

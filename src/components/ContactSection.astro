---
// src/components/ContactSection.astro
import founder from '@/assets/images/founder.png';
import AvailabilityBadge from './AvailabilityBadge.astro';
import ContactActions from './ContactActions.astro';

interface ContactStrings {
  title: string;
  titleAccent: string;
  headline: string;
  subhead: string;
  email: string;
  phone: string;
  portraitAlt: string; // Should be descriptive e.g. "Jesus Ordosgoitty — Full Stack Web Developer"
}

interface Props {
  strings: ContactStrings;
  lang?: string;
}

const { strings, lang = 'en' } = Astro.props;
---

<section id="contact" class="py-24 relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-left mb-20 animate-fade-in">
      <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
        {strings.title}{' '}
        <span class="text-primary">{strings.titleAccent}</span>
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16">
      <!-- Contact Actions -->
      <div class="space-y-10 animate-slide-up order-2 lg:order-1">
        <div class="space-y-6 text-left">
          <h3 class="text-3xl font-bold text-foreground">
            {strings.headline}
          </h3>
          <p class="text-muted-foreground text-lg leading-relaxed">
            {strings.subhead}
          </p>
        </div>

        <ContactActions lang={lang} />
      </div>

      <!-- Portrait & Status -->
      <div class="flex flex-col items-center justify-center space-y-8 order-1 lg:order-2">
        <!-- Mobile/Desktop Image -->
        <div class="w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80 xl:w-96 xl:h-96 bg-white relative rounded-none overflow-hidden transition-all duration-500 hover:shadow-glow hover:z-20 border-2 border-border animate-slide-up-delayed group">
          <img
            src={founder.src}
            alt={strings.portraitAlt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
        
        <AvailabilityBadge lang={lang} />
      </div>
    </div>
  </div>
  <!-- Subtle Background Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full max-w-4xl max-h-4xl bg-primary/5 blur-[120px] rounded-full -z-10"></div>
</section>

---
// src/components/Header.astro
import type { Lang } from '@/lib/i18n';
import brandLogo from '@/assets/jodaz.png';
import HeaderInteractive from '@/components/HeaderInteractive.tsx';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const altLangHref = lang === 'es' ? Astro.url.pathname.replace('/es', '') || '/' : `/es${Astro.url.pathname}`;
---

<HeaderInteractive
  logoSrc={brandLogo.src}
  lang={lang}
  altLangHref={altLangHref}
  client:load
/>
